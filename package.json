{
    "name": "kearisp",
    "type": "module",
    "version": "2.0.14",
    "description": "Workspace for my node.js projects",
    "author": "Kris Papercut <krispcut@gmail.com>",
    "license": "MIT",
    "main": "",
    "keywords": [
        "kp"
    ],
    "private": true,
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "start": "concurrently \"npm:watch\" \"npm:watch:*\"",
        "build-all": "concurrently \"npm:build\" \"npm:build:*\"",
        "build": "vite build",
        "fodec:build": "fodec gen && fodec build",
        "build:fodec": "npm run build --workspace fodec",
        "build:motor-js": "npm run build --workspace motor-js",
        "build:react-canny": "npm run build --workspace react-canny",
        "build:react-compose-form": "npm run build --workspace react-compose-form",
        "postbuild": "cp build/index.html build/404.html",
        "watch": "vite",
        "watch:fodec": "npm run watch --workspace fodec",
        "watch:motor-js": "npm run watch --workspace motor-js",
        "watch:react-canny": "npm run watch --workspace react-canny",
        "watch:react-compose-form": "npm run watch --workspace react-compose-form",
        "test": "concurrently \"npm:test:*\"",
        "test:form": "npm run test --workspace react-compose-form"
    },
    "dependencies": {
        "@radix-ui/react-dropdown-menu": "^2.1.16",
        "@radix-ui/react-switch": "^1.2.6",
        "clsx": "^2.1.1",
        "i18next-http-backend": "^2.4.2",
        "lucide-react": "^1.16.0",
        "motor-js": "^0.0.1",
        "navigation-kit": "^0.0.3",
        "path-browserify": "^1.0.1",
        "react": "^19.2.0",
        "react-canny": "^0.0.8",
        "react-compose-form": "^0.0.1",
        "react-dom": "^19.2.0",
        "react-hook-form": "^7.49.3",
        "react-i18next": "^11.12.0",
        "react-router-dom": "^6.21.3"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.3.0",
        "@tailwindcss/vite": "^4.3.0",
        "@testing-library/jest-dom": "^5.14.1",
        "@testing-library/react": "^11.2.7",
        "@testing-library/user-event": "^12.8.3",
        "@types/jest": "^26.0.24",
        "@types/node": "^22.10.2",
        "@types/path-browserify": "^1.0.2",
        "@types/react": "^19.2.2",
        "@types/react-dom": "^19.2.2",
        "@types/serviceworker": "^0.0.101",
        "@vitejs/plugin-react": "^6.0.2",
        "concurrently": "^6.3.0",
        "fodec": "^1.0.0",
        "postcss": "^8.5.15",
        "postcss-import": "^16.1.1",
        "sass-embedded": "^1.100.0",
        "tailwindcss": "^4.3.0",
        "typescript": "^5.9.3",
        "vite": "^8.0.14"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    }
}
